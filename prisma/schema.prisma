// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init




generator client {
  provider      = "prisma-client"     
  output        = "../generated" 
  compilerBuild = "fast"             
}

datasource db {
  provider = "postgresql"
}




// ---------------------
// Modèle User
// ---------------------
model User {
  id                 String     @id
  username           String     
  name               String
  bio                String?    
  profile_picture_url String?   
  created_at         DateTime   
  
  // Relations
  companies          Company[]   @relation("UserCompanies")
  posts              Post[]      @relation("UserPosts")
  messages           Message[]

  @@map("users")
}

// ---------------------
// Modèle Company
// ---------------------
model Company {
  id                   String   @id
  title                String
  description          String?
  verified             Boolean  @default(false)
  business_type        String?
  industry_type        String?
  send_customer_emails  Boolean @default(true)
  created_at           DateTime
  updated_at           DateTime
  member_count         Int      @default(0)
  route                String?
  logo_url             String?
  
  // Foreign key vers User
  user_id              String
  user                 User     @relation("UserCompanies", fields: [user_id], references: [id])
  
  // Relations
  forums               Forum[]
  chat_channels        ChatChannel[]
    customized_risques   CustomizedRisque[]   @relation("CustomizedRisqueCompany")
    regles               Regle[]
  
  
    @@map("companies")
}

// ---------------------
// Modèle Forum
// ---------------------
model Forum {
  id                          String   @id
  experience_id               String   @unique
  experience_name             String
  company_id                  String
  is_moderated                Boolean  @default(false)
  ban_media                   Boolean  @default(false)
  who_can_post                String?
  who_can_comment             String?
  email_notification_preference String?
  forumContext                String 
  forumLanguage               String
  

  // Polling fields
  last_polled_at              DateTime?
  polling_failed              Boolean  @default(false)
  last_external_post_id       String?
  last_polling_error          String?

  // Relation avec Company
  company                     Company @relation(fields: [company_id], references: [id])
  
  // Relation avec Posts
  posts                       Post[]
  regles                      Regle[]

  @@map("forums")
}

// ---------------------
// Modèle Post  chat_channel            ChatChannel @relation(fields: [chat_channel_id], references: [id])

// ---------------------
model Post {
  id              String   @id
  forum_id        String
  title           String?
  content         String?
  created_at      DateTime
  updated_at      DateTime
  is_edited       Boolean  @default(false)
  is_poster_admin Boolean  @default(false)
  is_pinned       Boolean  @default(false)
  parent_id       String?  
  user_id         String
  view_count      Int      @default(0)
  like_count      Int      @default(0)
  comment_count   Int      @default(0)

  // Relations
  forum           Forum    @relation(fields: [forum_id], references: [id])
  user            User     @relation("UserPosts", fields: [user_id], references: [id])
  
  // Auto-relation pour replies / parent post
  parent          Post?    @relation("PostParentChild", fields: [parent_id], references: [id])
  children        Post[]   @relation("PostParentChild")


  @@map("posts")
}

// ---------------------
// Modèle ChatChannel
// ---------------------
model ChatChannel {
  id                          String   @id
  experience_id               String   @unique
  experience_name             String
  ban_media                   Boolean  @default(false)
  ban_urls                    Boolean  @default(false)
  who_can_post                String?
  who_can_react               String?
  user_posts_cooldown_seconds Int?
  banned_words                String[]

  // Relation avec Company
  company_id                  String
  company                     Company  @relation(fields: [company_id], references: [id])

  // Relation avec Messages
  messages                    Message[]

  @@map("chat_channels")
}

// ---------------------
// Modèle Message
// ---------------------
model Message {
  id                      String   @id
  content                 String?
  created_at              DateTime
  updated_at              DateTime
  poll                    Json?
  replying_to_message_id  String?
  is_edited               Boolean  @default(false)
  is_pinned               Boolean  @default(false)
  message_type            String?
  view_count              Int      @default(0)
  reaction_counts         Json?
  poll_votes              Json?

  // Relations
  user_id                 String
  user                    User     @relation(fields: [user_id], references: [id])
  chat_channel_id         String
  chat_channel            ChatChannel @relation(fields: [chat_channel_id], references: [id])
  
  // Auto-relation pour replies
  replying_to             Message?  @relation("MessageReplies", fields: [replying_to_message_id], references: [id])
  replies                 Message[] @relation("MessageReplies")

  @@map("messages")
}





model Risque{
  id          Int       @id @default(autoincrement()) 
  nom        String     @unique 
  description    String  
  regles      Regle[]  // Bidirectional relation

  @@map("risques")
}

model CustomizedRisque{
  id          Int       @id @default(autoincrement()) 
  nom        String     @unique 
  description    String
  company_id       String   
  company   Company  @relation("CustomizedRisqueCompany", fields: [company_id], references: [id])
  regles      Regle[] // Bidirectional relation


  @@map("customized_risques")
}



enum Degre {
  TOLERANT
  MODERE
  STRICT
  ZERO_TOLERANCE
}
enum ActionType{
  ON_USER
  ON_CONTENT
}

model Action {
  id        Int        @id @default(autoincrement())
  nom       String     @unique
  desc      String
  type      ActionType 
  regleActions RegleActions[]   // Bidirectional relation
}

model Regle {
  id                    Int          @id @default(autoincrement())
  risque_id             Int?
  customized_risque_id  Int?
  forum_id              String
  degre                 Degre
  company_id            String?

  company               Company?     @relation(fields: [company_id], references: [id])
  risque                Risque?      @relation(fields: [risque_id], references: [id])
  customized_risque     CustomizedRisque? @relation(fields: [customized_risque_id], references: [id])
  forum                 Forum      @relation(fields: [forum_id], references: [id])
  regleActions          RegleActions[]
}


model RegleActions {
  id              Int @id @default(autoincrement())
  id_regle        Int
  id_action       Int
  

  regle           Regle @relation(fields: [id_regle], references: [id])
  action          Action @relation(fields: [id_action], references: [id])
  @@map("regle_actions")

}


