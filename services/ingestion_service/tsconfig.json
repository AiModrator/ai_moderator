{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",            /* Dossier de sortie indispensable */
    "rootDir": "./src",             /* Force la structure à partir de src */
    "baseUrl": ".",
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true        /* Recommandé pour la compatibilité Express */
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}