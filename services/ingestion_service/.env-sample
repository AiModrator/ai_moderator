# Base de données D-04 (schéma public)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_moderator?schema=public"

# Redis (dépendance du cache-aside et du bucket de tokens)
REDIS_HOST=localhost
REDIS_PORT=6379

# Nom de la queue BullMQ
CONTENT_QUEUE_NAME=contentQueue

# Serveur HTTP
HTTP_PORT=3000

# Bucket de tokens global (throttling)
THROTTLE_CAPACITY=200
THROTTLE_COST_PER_TOKEN=1
THROTTLE_REFILL_INTERVAL_MS=60000

# Plafond de backlog par communauté (+ TTL d'auto-guérison du compteur)
BACKLOG_MAX_POSTS_PER_COMMUNITY=1000
BACKLOG_TTL_SECONDS=3600

# TTL du cache-aside de configuration communauté (secondes)
CONFIG_CACHE_TTL_SECONDS=300

# Secret HMAC de hachage des clés API (OBLIGATOIRE)
API_KEY_HMAC_SECRET=change-me

# Bornes de validation du payload entrant
MAX_ITEMS_PER_BATCH=1000

# Options de retry/backoff par défaut des jobs
QUEUE_ATTEMPTS=1
QUEUE_BACKOFF_MS=1000

# Format de log : console | json
LOG_FORMAT=console