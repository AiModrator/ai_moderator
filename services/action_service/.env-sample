# ============================================================================
# action_service — variables d'environnement (exemple)
# Copier vers .env (ou .env.local) et adapter. Validées au démarrage.
# ============================================================================

# ---------- HTTP ----------
HTTP_PORT=3001

# ---------- D-04 (Postgres / Prisma, partagé avec ingestion) ----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_moderator

# ---------- Redis (BullMQ uniquement) ----------
REDIS_HOST=localhost
REDIS_PORT=6379
DECISION_QUEUE_NAME=decisionQueue      # consommée (Moderation → Action)
DECISION_WORKER_CONCURRENCY=5          # jobs décision traités en parallèle

# ---------- D-02 (MongoDB — historique) ----------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ai_moderator_history

# ---------- Seuils de sévérité par défaut (si Threshold absent en D-04) ----------
DEFAULT_LOW=0.25
DEFAULT_MEDIUM=0.50
DEFAULT_HIGH=0.75
DEFAULT_CRITICAL=1.00

# ---------- Callback client ----------
CALLBACK_TIMEOUT_MS=5000
CALLBACK_MAX_ATTEMPTS=5
CALLBACK_BASE_DELAY_MS=1000
CALLBACK_MAX_DELAY_MS=30000

# ---------- Logs ----------
LOG_LEVEL=info                          # trace|debug|info|warn|error