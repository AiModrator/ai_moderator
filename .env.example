# ============================================================================
# .env — variables d'environnement pour docker-compose (racine du repo)
# Copier vers `.env` et adapter. Ce fichier est git-ignoré (secrets).
# ============================================================================

# ---------- AI Gateway (requis par ai-gateway + moderation_service) ----------
# Clé Fernet : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_GATEWAY_ENCRYPTION_KEY=
# Clé partagée : le moderation_service appelle la gateway avec ce Bearer token.
AI_GATEWAY_API_KEY=
# Clé admin : utilisée pour les appels /v1/admin/* (header X-Admin-Key).
AI_GATEWAY_ADMIN_API_KEY=

# ---------- OpenRouter (optionnel, pour le provider réel) ----------
OPENROUTER_API_KEY=