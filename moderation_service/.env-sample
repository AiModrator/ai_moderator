# ============================================================================
# moderation_service — variables d'environnement (exemple)
# Copier vers .env (ou .env.local, chargé en premier) et adapter.
# Toutes les valeurs sont validées au démarrage (app/config/settings.py).
# ============================================================================

# ---------- Redis / BullMQ ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CONTENT_QUEUE_NAME=contentQueue          # consommée (Ingestion → Moderation)
DECISION_QUEUE_NAME=decisionQueue        # produite  (Moderation → Action)

# ---------- HTTP ----------
HTTP_PORT=8000                           # FastAPI : GET /health

# ---------- WorkerPool (concurrence dynamique, asyncio) ----------
WORKER_POOL_MIN=2                        # capacité minimale du sémaphore dynamique
WORKER_POOL_INITIAL=4                    # capacité au démarrage (MIN <= INITIAL <= MAX)
WORKER_POOL_MAX=32                       # capacité maximale = concurrency du Worker BullMQ
SCALE_STEP=2                             # +/- workers par décision d'auto-scaling
SCALE_COOLDOWN_SEC=10                    # délai minimal entre deux changements de capacité
MONITOR_INTERVAL_SEC=5                   # période d'échantillonnage psutil

# Seuils d'auto-scaling (pourcentages 0-100)
CPU_LOW_PCT=65                           # CPU < LOW et RAM < RAM_LOW et jobs en attente → scale up
CPU_HIGH_PCT=85                          # CPU > HIGH → scale down
RAM_LOW_PCT=70
RAM_HIGH_PCT=80                          # RAM > HIGH → scale down
RAM_CRITICAL_PCT=90                      # RAM >= CRITICAL → backpressure (capacité 0) + purge caches

# ---------- Retry sélectif (géré par le Worker, pas par BullMQ) ----------
MAX_FILTER_RETRIES=3                     # ré-exécutions max d'un filtre en erreur transitoire
RETRY_BASE_DELAY_MS=5000                 # délai du 1er retry ; backoff exponentiel x2
RETRY_MAX_DELAY_MS=300000                # plafond du délai (5 min)

# ---------- Lot / filtres ----------
MAX_ITEMS_PER_BATCH=50                   # validation du payload contentQueue
FILTER_TIMEOUT_SEC=10                    # timeout par défaut des filtres à règles (Spam, Link, Lexicon)
FILTERS_DISABLED=                        # ex: ImageAIFilter,LinkFilter

# ---------- AI Gateway (service dédié, conçu en phase 4/5 — contrat provisoire) ----------
AI_GATEWAY_URL=http://localhost:4000
AI_GATEWAY_API_KEY=
AI_REQUEST_TIMEOUT_SEC=30                # timeout d'un appel gateway (par sous-lot / par image)
AI_MAX_PARALLEL_REQUESTS=4               # appels gateway simultanés par job
AI_TEXT_BATCH_SIZE=10                    # items par appel TextAIFilter
AI_TEXT_MAX_CHARS_PER_ITEM=4000          # troncature du texte envoyé
AI_TEXT_MIN_CHARS=2                      # en dessous → item SKIPPED pour TextAIFilter
MAX_IMAGES_PER_ITEM=4                    # ImageAIFilter : images au-delà ignorées

# ---------- SpamFilter (Redis) ----------
SPAM_DUP_WINDOW_SEC=3600                 # fenêtre de détection des doublons par communauté
SPAM_FLOOD_WINDOW_SEC=60                 # fenêtre de comptage des messages par utilisateur
SPAM_FLOOD_THRESHOLD=10                  # messages/fenêtre au-delà desquels on considère du flood

# ---------- LinkFilter ----------
LINK_ALLOWLIST_DOMAINS=                  # ex: youtube.com,github.com (sous-domaines inclus)
LINK_SUSPICIOUS_TLDS=zip,mov,tk,top,xyz,gq,ml,cf,click,work

# ---------- LexiconFilter ----------
LEXICON_MAX_SCORE=0.85                  # plafond de score émis par le lexique (∈ [0,1])

# ---------- Arrêt / logs ----------
SHUTDOWN_TIMEOUT_SEC=30                  # drain gracieux des jobs en cours
LOG_LEVEL=INFO                           # DEBUG|INFO|WARNING|ERROR
LOG_FORMAT=json                          # json|console

# ---------- Tests uniquement ----------
TEST_QUEUE_PREFIX=test                   # préfixe des queues BullMQ utilisées par pytest
