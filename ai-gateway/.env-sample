# ============================================================================
# ai-gateway — variables d'environnement (exemple)
# Copier vers .env (ou .env.local) et adapter. Validées au démarrage (app/config/settings.py).
# ============================================================================

# ---------- HTTP ----------
HTTP_PORT=4000                            # FastAPI

# ---------- MongoDB (D-03 — credentials & budget IA) ----------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ai_gateway

# ---------- Sécurité ----------
# Générer une clé : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=                           # REQUIS — chiffrement des clés fournisseurs (Fernet)
GATEWAY_API_KEY=                          # REQUIS — auth des endpoints de modération (Bearer)
ADMIN_API_KEY=                            # REQUIS — auth des endpoints admin (X-Admin-Key)

# ---------- Fournisseurs / réseau ----------
REQUEST_TIMEOUT_SEC=30                    # timeout d'un essai HTTP vers un provider
RETRY_MAX=3                               # retries réseau (backoff exponentiel)
RETRY_BASE_DELAY_MS=500                   # délai du 1er retry
RETRY_MULTIPLIER=2                        # facteur exponentiel
RETRY_MAX_DELAY_MS=8000                   # plafond de délai

# ---------- Validation / fallback ----------
RESPONSE_RETRY=1                          # re-essais d'un même modèle sur réponse non conforme
FALLBACK_TO_TEST_PROVIDER=false           # autorise le fallback final vers le provider "test" (dev uniquement)

# ---------- Requêtes de modération ----------
MAX_ITEMS_PER_REQUEST=100                 # items max par appel /v1/moderation/*
DEFAULT_ACCOUNT_ID=default                # compte implicite si accountId absent

# ---------- Budget / usage ----------
BUDGET_DEFAULT_MONTHLY_LIMIT=100.0        # USD — limite implicite d'un nouveau budget
USAGE_RETENTION_DAYS=90                   # TTL des enregistrements usage (MongoDB)

# ---------- Arrêt / logs ----------
SHUTDOWN_TIMEOUT_SEC=15                   # drain gracieux
LOG_LEVEL=INFO                            # DEBUG|INFO|WARNING|ERROR
LOG_FORMAT=json                           # json|console

# ---------- Tests uniquement ----------
# MONGODB_DB_TEST=ai_gateway_test         # base utilisée par pytest (défaut: <MONGODB_DB>_test)