generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
}

/// Classes de risque détectées (canonique : @ai-moderator/database)
/// Miroir indispensable dans moderation_service (Python) et ai-gateway (Python).
enum RiskClass {
  SPAM
  SCAM
  PHISHING
  MALICIOUS_LINK
  ADVERTISING
  TOXICITY
  INSULT
  HARASSMENT
  HATE_SPEECH
  THREAT
  VIOLENCE
  SEXUAL
  SELF_HARM
  ILLEGAL
  OFF_TOPIC
}

/// Échelle de sévérité (ordre strict : LOW < MEDIUM < HIGH < CRITICAL)
enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Sanctions applicables au contenu
enum ContentAction {
  ALLOW
  HIDE_POST
  DELETE_POST
  EDIT_POST
  LOCK_POST
  REMOVE_ATTACHMENT
  FLAG_FOR_REVIEW
}

/// Sanctions applicables à l'utilisateur
enum UserAction {
  NONE
  WARN_USER
  MUTE_USER
  TIMEOUT_USER
  BAN_USER
  TEMP_BAN_USER
}

model Account {
  id          String      @id @default(uuid())
  email       String      @unique
  communities Community[]

  @@map("accounts")
}

model Community {
  id          String    @id @default(uuid())
  accountId   String
  name        String
  isDefault   Boolean   @default(false)
  callbackUrl String

  account  Account   @relation(fields: [accountId], references: [id])
  apiKeys  ApiKey[]
  workflow Workflow?

  @@map("communities")
}

model ApiKey {
  id          String    @id @default(uuid())
  communityId String
  hashedKey   String    @unique
  revokedAt   DateTime?

  community Community @relation(fields: [communityId], references: [id])

  @@map("api_keys")
}

/// Une communauté = un workflow actif (Workflow.communityId unique).
model Workflow {
  id          String @id @default(uuid())
  communityId String @unique
  name        String

  community Community @relation(fields: [communityId], references: [id])
  rules     Rule[]

  @@map("workflows")
}

/// Une règle = une combinaison classe + seuil, déclenchant 1..n actions.
model Rule {
  id             String          @id @default(uuid())
  workflowId     String
  riskClass      RiskClass
  severity       Severity
  contentActions ContentAction[]
  userActions    UserAction[]

  workflow Workflow @relation(fields: [workflowId], references: [id])

  @@unique([workflowId, riskClass, severity])
  @@map("rules")
}